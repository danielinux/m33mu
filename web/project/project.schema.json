{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m33mu.dev/schemas/web-project-v1.json",
  "title": "m33mu Web Workbench Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "simulator", "boards", "contacts", "nets", "components", "instruments"],
  "properties": {
    "schemaVersion": {"const": 1},
    "projectId": {"type": "string", "minLength": 1},
    "name": {"type": "string", "maxLength": 256},
    "simulator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "firmwareFormat", "firmwareSha256"],
      "properties": {
        "cpu": {"type": "string", "enum": ["stm32h533", "stm32h563", "stm32h5f4", "stm32u585", "stm32l552", "lpc55s69", "mcxw71c", "mcxn947", "rw612", "nrf5340", "nrf54lm20", "rp2350", "pic32ck", "m2354", "imxrt700"]},
        "firmwareFormat": {"enum": ["elf", "bin", "hex", "uf2"]},
        "firmwareSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "firmwareName": {"type": "string", "maxLength": 256},
        "cpuHz": {"type": "integer", "minimum": 1},
        "firmwareBase64": {"type": "string", "contentEncoding": "base64"}
      }
    },
    "boards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cpu", "layoutVersion", "x", "y", "rotation", "electricalEnabled"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "cpu": {"type": "string"},
          "layoutVersion": {"type": "integer", "minimum": 1},
          "x": {"type": "number"}, "y": {"type": "number"},
          "rotation": {"enum": [0, 90, 180, 270]},
          "electricalEnabled": {"type": "boolean"}
        }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["boardId", "connectorId", "physicalPadNumber", "mappingStatus"],
        "properties": {
          "boardId": {"type": "string"},
          "connectorId": {"type": "string"},
          "physicalPadNumber": {"type": "integer", "minimum": 1},
          "mappingStatus": {"enum": ["unverified", "verified", "visual-only"]},
          "socPad": {"type": ["string", "null"]},
          "functionId": {"type": ["string", "null"]},
          "source": {"type": "string", "maxLength": 2048},
          "sourceRevision": {"type": "string", "maxLength": 128}
        }
      }
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "endpoints"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "endpoints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/endpoint"}},
          "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "x", "y", "rotation", "parameters", "terminals"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "x": {"type": "number"}, "y": {"type": "number"},
          "rotation": {"type": "number"},
          "parameters": {"type": "object"},
          "terminals": {"type": "object", "additionalProperties": {"type": "string"}}
        }
      }
    },
    "instruments": {"type": "array", "items": {"type": "object"}},
    "ui": {"type": "object"}
  },
  "$defs": {
    "endpoint": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "boardId", "connectorId", "physicalPadNumber"], "properties": {"kind": {"const": "board-contact"}, "boardId": {"type": "string"}, "connectorId": {"type": "string"}, "physicalPadNumber": {"type": "integer", "minimum": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "componentId", "terminalId"], "properties": {"kind": {"const": "component-terminal"}, "componentId": {"type": "string"}, "terminalId": {"type": "string"}}}
      ]
    }
  }
}
