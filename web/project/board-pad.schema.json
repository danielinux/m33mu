{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m33mu.dev/schemas/board-pad-v1.json",
  "title": "m33mu Board Pad Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "boardId", "cpu", "boardRevision", "contacts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "boardId": {"type": "string", "minLength": 1},
    "cpu": {"type": "string", "minLength": 1},
    "boardRevision": {"type": "string", "minLength": 1},
    "electricalMapStatus": {"enum": ["unverified", "signal-mapping-verified; artwork-anchor-pending", "verified"]},
    "sources": {"type": "array", "items": {"type": "object", "required": ["kind", "url", "revision", "evidence"], "properties": {"kind": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "revision": {"type": "string"}, "evidence": {"type": "string"}}}},
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connectorId", "physicalPadNumber", "signalMappingVerified", "artworkAnchorVerified", "electricalEnabled"],
        "properties": {
          "connectorId": {"type": "string", "minLength": 1},
          "physicalPadNumber": {"type": "integer", "minimum": 1},
          "socPad": {"type": "string"},
          "peripheralFunctions": {"type": "array", "items": {"type": "string"}},
          "signalMappingVerified": {"type": "boolean"},
          "artworkAnchorVerified": {"type": "boolean"},
          "electricalEnabled": {"type": "boolean"}
        },
        "allOf": [
          {
            "if": {"properties": {"electricalEnabled": {"const": true}}},
            "then": {"properties": {"signalMappingVerified": {"const": true}, "artworkAnchorVerified": {"const": true}}}
          }
        ]
      }
    },
    "review": {"type": "object", "additionalProperties": false, "required": ["reviewer", "reviewedAt", "note"], "properties": {"reviewer": {"type": "string"}, "reviewedAt": {"type": "string", "format": "date"}, "note": {"type": "string"}}}
  }
}
