{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://m33mu.dev/schemas/web-project-v2.json",
 "title": "m33mu Web Workbench Project v2",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schemaVersion",
  "projectId",
  "name",
  "simulator",
  "boards",
  "parts",
  "wires",
  "instruments",
  "solver",
  "ui"
 ],
 "properties": {
  "schemaVersion": {
   "const": 2
  },
  "projectId": {
   "type": "string",
   "minLength": 1
  },
  "name": {
   "type": "string"
  },
  "simulator": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "cpu",
    "firmwareFormat",
    "firmwareSha256",
    "firmwareName"
   ],
   "properties": {
    "cpu": {
     "const": "stm32h563"
    },
    "firmwareFormat": {
     "const": "elf"
    },
    "firmwareSha256": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      }
     ]
    },
    "firmwareName": {
     "type": "string"
    },
    "firmwareBase64": {
     "type": "string"
    }
   }
  },
  "boards": {
   "type": "array",
   "maxItems": 2000,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "cpu",
     "layoutRevision",
     "x",
     "y"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "cpu": {
      "const": "stm32h563"
     },
     "layoutRevision": {
      "type": "string"
     },
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     }
    }
   }
  },
  "parts": {
   "type": "array",
   "maxItems": 2000,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "kind",
     "x",
     "y",
     "rotation",
     "params"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "kind": {
      "enum": [
       "breadboard",
       "resistor",
       "capacitor",
       "led",
       "diode",
       "switch",
       "npn",
       "nmos",
       "opamp",
       "regulator",
       "supply",
       "ground",
       "i2c-eeprom",
       "i2c-temp",
       "spi-flash",
       "usb-uart",
       "sniffer"
      ]
     },
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "rotation": {
      "enum": [
       0,
       90,
       180,
       270
      ]
     },
     "params": {
      "type": "object",
      "additionalProperties": {
       "type": [
        "number",
        "string"
       ]
      }
     }
    }
   }
  },
  "wires": {
   "type": "array",
   "maxItems": 2000,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "from",
     "to",
     "color"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "from": {
      "$ref": "#/$defs/terminal"
     },
     "to": {
      "$ref": "#/$defs/terminal"
     },
     "color": {
      "type": "string"
     }
    }
   }
  },
  "instruments": {
   "type": "object",
   "oneOf": [
    {
     "additionalProperties": false,
     "required": [
      "scopes"
     ],
     "properties": {
      "scopes": {
       "type": "array",
       "maxItems": 8,
       "items": {
        "allOf": [
         {
          "$ref": "#/$defs/scope"
         },
         {
          "required": [
           "id",
           "name"
          ],
          "properties": {
           "id": {
            "type": "string",
            "minLength": 1
           },
           "name": {
            "type": "string"
           }
          }
         }
        ]
       }
      },
      "terminals": {
       "type": "array",
       "maxItems": 32,
       "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]{1,15}$"
       }
      }
     }
    },
    {
     "additionalProperties": false,
     "required": [
      "scope"
     ],
     "properties": {
      "scope": {
       "$ref": "#/$defs/scope"
      }
     }
    }
   ]
  },
  "solver": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "lookaheadNs",
    "sampleNs"
   ],
   "properties": {
    "lookaheadNs": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "sampleNs": {
     "type": "number",
     "exclusiveMinimum": 0
    }
   }
  },
  "ui": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "zoom",
    "panX",
    "panY"
   ],
   "properties": {
    "zoom": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "panX": {
     "type": "number"
    },
    "panY": {
     "type": "number"
    }
   }
  }
 },
 "$defs": {
  "terminal": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "part",
      "terminal"
     ],
     "properties": {
      "kind": {
       "const": "part"
      },
      "part": {
       "type": "string"
      },
      "terminal": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "board",
      "contact"
     ],
     "properties": {
      "kind": {
       "const": "board"
      },
      "board": {
       "type": "string"
      },
      "contact": {
       "type": "string"
      }
     }
    }
   ]
  },
  "probe": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "at"
     ],
     "properties": {
      "kind": {
       "const": "voltage"
      },
      "at": {
       "$ref": "#/$defs/terminal"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "part"
     ],
     "properties": {
      "kind": {
       "const": "current"
      },
      "part": {
       "type": "string"
      }
     }
    }
   ]
  },
  "scope": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "channels",
    "windowNs"
   ],
   "allOf": [
    {
     "if": {
      "properties": {
       "acquisition": {
        "enum": [
         "normal",
         "single"
        ]
       }
      },
      "required": [
       "acquisition"
      ]
     },
     "then": {
      "required": [
       "trigger"
      ],
      "properties": {
       "trigger": {
        "type": "object"
       }
      }
     }
    }
   ],
   "properties": {
    "channels": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "items": {
      "oneOf": [
       {
        "type": "null"
       },
       {
        "$ref": "#/$defs/probe"
       }
      ]
     }
    },
    "windowNs": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "acquisition": {
     "enum": [
      "auto",
      "normal",
      "single"
     ]
    },
    "trigger": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "channel",
        "edge",
        "level"
       ],
       "properties": {
        "channel": {
         "enum": [
          0,
          1
         ]
        },
        "edge": {
         "enum": [
          "rising",
          "falling"
         ]
        },
        "level": {
         "type": "number"
        }
       }
      }
     ]
    },
    "id": {
     "type": "string",
     "minLength": 1
    },
    "name": {
     "type": "string"
    }
   }
  }
 }
}
