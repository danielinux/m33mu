{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m33mu.dev/schemas/worker-message-v1.json",
  "title": "m33mu Web Worker RPC Message",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "operation",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "request"
        },
        "requestId": {
          "type": "integer",
          "minimum": 1
        },
        "operation": {
          "enum": [
            "loadFirmware",
            "run",
            "pause",
            "step",
            "reset",
            "gpioWrite",
            "compileNetlist",
            "createBench",
            "runUntil",
            "setSwitch",
            "destroyBench",
            "diagnostics"
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "gpioWrite"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": [
                  "socPad",
                  "level",
                  "eventTimeNs"
                ],
                "properties": {
                  "socPad": {
                    "type": "string",
                    "minLength": 1
                  },
                  "level": {
                    "type": "boolean"
                  },
                  "eventTimeNs": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "compileNetlist"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": [
                  "netlist"
                ],
                "properties": {
                  "netlist": {
                    "type": "object",
                    "required": [
                      "schemaVersion",
                      "devices"
                    ],
                    "properties": {
                      "schemaVersion": {
                        "const": 1
                      },
                      "devices": {
                        "type": "array",
                        "maxItems": 2000,
                        "items": {
                          "type": "object",
                          "required": [
                            "kind",
                            "id"
                          ],
                          "properties": {
                            "kind": {
                              "enum": [
                                "ground",
                                "resistor",
                                "capacitor",
                                "inductor",
                                "vsource",
                                "isource",
                                "diode",
                                "led",
                                "switch",
                                "npn",
                                "pnp",
                                "nmos",
                                "pmos",
                                "opamp",
                                "regulator",
                                "pad"
                              ]
                            },
                            "id": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "createBench"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": [
                  "netlist"
                ],
                "properties": {
                  "netlist": {
                    "type": "object",
                    "required": [
                      "schemaVersion",
                      "devices"
                    ],
                    "properties": {
                      "schemaVersion": {
                        "const": 1
                      },
                      "devices": {
                        "type": "array",
                        "maxItems": 2000,
                        "items": {
                          "type": "object",
                          "required": [
                            "kind",
                            "id"
                          ],
                          "properties": {
                            "kind": {
                              "enum": [
                                "ground",
                                "resistor",
                                "capacitor",
                                "inductor",
                                "vsource",
                                "isource",
                                "diode",
                                "led",
                                "switch",
                                "npn",
                                "pnp",
                                "nmos",
                                "pmos",
                                "opamp",
                                "regulator",
                                "pad"
                              ]
                            },
                            "id": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    }
                  },
                  "probes": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "kind"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "enum": [
                            "voltage",
                            "current",
                            "pad"
                          ]
                        }
                      }
                    }
                  },
                  "options": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "lookaheadNs": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "sampleNs": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "maxSamples": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "initial": {
                        "enum": [
                          "dc",
                          "zero"
                        ]
                      }
                    }
                  },
                  "solver": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "hMax": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "reltol": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "eventTol": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "runUntil"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "targetNs": {
                    "type": "string",
                    "pattern": "^[0-9]{1,16}$"
                  },
                  "maxRatio": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "setSwitch"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": [
                  "device",
                  "closed"
                ],
                "properties": {
                  "device": {
                    "type": "string",
                    "minLength": 1
                  },
                  "closed": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "ok"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "response"
        },
        "requestId": {
          "type": "integer",
          "minimum": 1
        },
        "ok": {
          "type": "boolean"
        },
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "sequence",
        "event",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "event"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "enum": [
            "state",
            "gpio",
            "uart",
            "fault",
            "traceChunk",
            "capabilities",
            "bench"
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "event": {
                "const": "gpio"
              }
            },
            "required": [
              "event"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": [
                  "requestId",
                  "socPad",
                  "level",
                  "eventTimeNs"
                ],
                "properties": {
                  "requestId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "socPad": {
                    "type": "string",
                    "minLength": 1
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "eventTimeNs": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
